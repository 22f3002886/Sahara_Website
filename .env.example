# SAHARA – The Social Welfare Society, IIT Madras
# Environment Configuration Template

# Resend API Key for contact form backend email delivery
# Obtain an API key from https://resend.com
RESEND_API_KEY=re_your_api_key_here

# Official recipient email for inquiries (defaults to connectwithsahara@study.iitm.ac.in)
CONTACT_NOTIFICATION_EMAIL=connectwithsahara@study.iitm.ac.in

# Optional verified sender address configured in Resend (e.g. contact@yourverifieddomain.com or onboarding@resend.dev for testing)
RESEND_FROM_EMAIL=SAHARA Inquiries <onboarding@resend.dev>
